# TMDB credentials — free at https://www.themoviedb.org/settings/api
# Either a v4 Read Access Token (Bearer)…
VITE_TMDB_READ_TOKEN=
# …or a v3 API key. Either one works; the token is preferred.
VITE_TMDB_API_KEY=

# Optional: leave empty for now. Reserved for a future self-hosted
# stream resolver (same role as Aurora's legacy server).
VITE_API_BASE_URL=
