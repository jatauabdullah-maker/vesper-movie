# --- required ---
# TMDB credentials live ONLY here, never in the frontend bundle.
# v4 Read Access Token (preferred) or v3 API key — either works.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# --- optional ---
PORT=8787
# Comma-separated origins allowed to call this API. Leave empty in dev to
# allow localhost. In production set your Vercel domain(s).
CORS_ORIGINS=https://vesper-movie.vercel.app

# Download queue
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=1
JOB_RETENTION_MINUTES=180
FILE_TTL_MINUTES=240

# Where the download resolver looks for playable files.
# jellyfin  — your own Jellyfin/Emby library (indexed by TMDB id)
# archive   — Internet Archive public-domain catalog (direct mp4, no auth)
# none      — downloads disabled (default)
DOWNLOAD_SOURCE=none
JELLYFIN_URL=
JELLYFIN_TOKEN=
